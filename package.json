{
  "name": "@gitwhy-cli/whyspec",
  "version": "0.1.4",
  "description": "The reasoning layer for AI-assisted development — capture WHY code was built the way it was",
  "type": "module",
  "main": "dist/cli/index.js",
  "module": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "bin": {
    "whyspec": "dist/cli/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gitwhy-cli/whyspec",
  "bugs": {
    "url": "https://github.com/gitwhy-cli/whyspec/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai-coding",
    "reasoning-layer",
    "developer-tools",
    "claude-code",
    "cursor",
    "ai-agents",
    "decision-bridge",
    "context-capture",
    "whyspec",
    "gitwhy",
    "typescript",
    "cli"
  ],
  "author": "Quan Nguyen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gitwhy-cli/whyspec.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.3"
  }
}
